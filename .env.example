# Neon PostgreSQL Database Connection String
# 1. Sign up / log in to Neon (https://console.neon.tech)
# 2. Create a project and database
# 3. Copy the Connection String (pooled or direct) from your Neon dashboard
# 4. Paste it below as DATABASE_URL and rename this file to .env
DATABASE_URL="postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Fallback Information:
# If DATABASE_URL is not set or cannot be reached, the server will automatically
# fallback to the local SQLite database (bills.sqlite).

# ==============================================================
# Google OAuth 2.0 Credentials
# ==============================================================
# In Google Cloud Console (https://console.cloud.google.com/):
# 1. Go to APIs & Services > Credentials
# 2. Create Credentials > OAuth client ID > Web application
# 3. Set "Authorized JavaScript origins":
#    - Production:  https://ledger.mudoker.com
#    - Development: http://localhost:3000
# 4. Set "Authorized redirect URIs":
#    - Production:  https://ledger.mudoker.com/api/auth/callback/google
#    - Development: http://localhost:3000/api/auth/callback/google
# 5. Paste Client ID and Client Secret below:
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Canonical App URL (used for OAuth redirects)
NEXT_PUBLIC_APP_URL="https://ledger.mudoker.com"

# Secret used to sign session JWTs (generate a strong random string)
AUTH_SECRET="super-secret-random-jwt-key"

# Application Environment Mode (Options: PROD, DEV - default is PROD)
# In PROD, demo data buttons and dev mock login are hidden.
# In .env.local, set NEXT_PUBLIC_APP_ENV=DEV to display demo samples.
NEXT_PUBLIC_APP_ENV=PROD
VITE_APP_ENV=PROD

# ==============================================================
# Web Push Notifications (VAPID)
# ==============================================================
# Generate keys with: bun -e "import webpush from 'web-push'; console.log(webpush.generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:huuquoc7603@gmail.com"
